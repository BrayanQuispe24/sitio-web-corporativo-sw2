# ========================================================
# CONFIGURACIÓN DE ENVÍO DE CORREOS - GMAIL (NODEMAILER)
# ========================================================

# Tu dirección de correo de Gmail
GMAIL_USER=tu_cuenta@gmail.com

# Contraseña de Aplicación de 16 letras generada en Google
# (NO es tu contraseña normal de inicio de sesión)
# Generala en: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Nombre que verá el cliente como remitente
SENDER_NAME=FitGo! by RandomSoft

# Correo interno de RandomSoft para recibir la alerta de cada nuevo lead
SALES_NOTIFICATION_EMAIL=ventas@randomsoft.io

# Datos del Sistema Demo que recibirá el cliente en el correo
DEMO_SYSTEM_URL=https://demo.fitgo.io
DEMO_ACCOUNT_EMAIL=demo@fitgo.io
DEMO_ACCOUNT_PASSWORD=FitGoDemo2026!
